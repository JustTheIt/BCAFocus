rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().role == 'admin';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // --- Collection Rules ---

    // Users: Users can read/write their own profile. Admins can read all.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated(); 
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin(); 
      allow delete: if isAdmin();
    }

    // 1️⃣ Materials (Admin + Student Uploads)
    match /materials/{materialId} {
      // Students can only read approved materials. Admins can read all.
      allow read: if isAuthenticated() && (resource.data.approved == true || isAdmin() || resource.data.uploaderId == request.auth.uid);
      
      // Admin can create anything. Students can create, but must set approved=false and uploadedBy='student'.
      allow create: if isAdmin() || (
        isAuthenticated() && 
        request.resource.data.approved == false && 
        request.resource.data.uploadedBy == 'student' &&
        request.resource.data.uploaderId == request.auth.uid
      );
      
      // Admin can update everything (approve/reject). Students can only update their own before approval.
      allow update: if isAdmin() || (
        isOwner(resource.data.uploaderId) && 
        resource.data.approved == false &&
        request.resource.data.approved == false
      );
      
      allow delete: if isAdmin() || isOwner(resource.data.uploaderId);
    }

    // 2️⃣ Projects (Created by Admin)
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 3️⃣ Student Project Submissions
    match /projectSubmissions/{submissionId} {
      // Students can read their own submissions. Admin can read all.
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      
      // Student can create their own submission.
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      
      // Admin can update status/feedback. Student can update their own submission if not already approved.
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.studentId == request.auth.uid && 
        resource.data.status != 'approved' &&
        request.resource.data.status == resource.data.status // Cannot change status themselves
      );
      
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
    }

    // 4️⃣ Career Resources (Admin Only Write)
    match /careerResources/{careerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Other Academic Content ---
    match /universities/{uniId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /syllabus/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Student Data (Owner/Admin only)
    match /studentPlanners/{userId} {
      allow list: if isAdmin();
      allow get: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }
    match /focusSessions/{userId} {
      allow list: if isAdmin();
      allow get: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }
    match /studentProjects/{userId} {
      allow list: if isAdmin();
      allow get: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Legacy/Existing Collections (Keeping for compatibility)
    match /tasks/{taskId} {
      allow read, write: if (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid)) || isAdmin();
    }
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
    }
  }
}

